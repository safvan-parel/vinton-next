generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String?  @unique
  password  String?
  createdAt DateTime @default(now())
  blogs     Blog[]
}

model Slider {
  id        Int      @id @default(autoincrement())
  title     String
  image     String
  desc      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id           Int      @id @default(autoincrement())
  title        String
  primaryImage String
  desc1        String?
  images       String[] @default([])
  desc2        String?
  active       Boolean  @default(true)
  createdById  Int
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Page {
  id               Int       @id @default(autoincrement())
  slug             String    @unique
  title            String
  type             String
  status           String    @default("draft")
  draftContent     Json
  publishedContent Json?
  publishedAt      DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}